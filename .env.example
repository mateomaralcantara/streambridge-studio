# Puerto del servidor
PORT=3000
HOST=0.0.0.0

# Tiempo de vida de salas inactivas (12h por defecto)
SESSION_TTL_MS=43200000

# OPCIONAL EN LOCAL. EN PRODUCCION VERCEL, apunta al backend persistente de senalizacion.
# Acepta wss://..., ws://..., https://... o http://...; el frontend normaliza y agrega /ws si hace falta.
SIGNAL_WS_URL=

# OPCIONAL pero recomendado para conexiones difíciles / redes móviles distintas.
# Ejemplo Coturn/Twilio/Xirsys, etc.
TURN_URL=turn:turn.tudominio.com:3478?transport=udp,turn:turn.tudominio.com:3478?transport=tcp
TURN_USERNAME=streambridge
TURN_CREDENTIAL=cambia-esta-clave
